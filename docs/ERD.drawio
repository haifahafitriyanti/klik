        <mxCell id="legend" value="ERD KLiK v6 FINAL (PRD v0.6)&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;[PK] primary key; [FK] foreign key; [UQ] UNIQUE. Kuning = master; biru = inti.&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Garis hitam = relasi bisnis; garis merah putus-putus = FK audit/self-reference.&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;DB constraints: users.nim UNIQUE; transactions.order_id UNIQUE; transactions.lapak_id UNIQUE NULLABLE; listings.active_lapak_id STORED GENERATED CASE WHEN status aktif THEN lapak_id ELSE NULL END + UNIQUE.&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Banding UNIQUE(moderation_action_id, nomor_banding), nomor 1..3; lapak.expires_at bergeser satu kali saat restore.&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;P0: webhook valid, lock transaksi, create lapak+listing atomik; late payment perlu_tinjauan. P1: reports. P2: terakhir_dikonfirmasi.&amp;lt;br&amp;gt;&amp;lt;br&amp;gt;Snapshot tc_accepted_at saat checkout di transactions, disalin ke lapaks setelah paid.&#10;&lt;br&amp;gt;Keputusan final: Inertia Vue 3, login NIM + password, akun ditolak diverifikasi ulang tanpa akun baru.&#10;&lt;br&amp;gt;reports.active_reporter_id GENERATED STORED = CASE WHEN status IN (menunggu,ditinjau) THEN reporter_id ELSE NULL END; UNIQUE(listing_id,active_reporter_id). Validasi Laravel tetap wajib." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="410" height="440" as="geometry"/>
        </mxCell>
